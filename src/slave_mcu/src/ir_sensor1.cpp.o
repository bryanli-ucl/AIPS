#include <Arduino.h>
#include <QTRSensors.h>

namespace {

QTRSensors qtr;

constexpr uint8_t SensorCount = 9;
constexpr uint8_t SensorPins[SensorCount] = { D2, D3, D4, D5, D7, A0, A1, A2, A3 };
constexpr uint8_t EmitterPin = D12;

constexpr bool FollowBlackLine = true;
constexpr uint16_t PositionCenter = (SensorCount - 1) * 1000 / 2;

constexpr float BaseSpeed = 90.0f;
constexpr float Kp = 0.045f;
constexpr float Kd = 0.22f;

constexpr float MaxCommand = 180.0f;
constexpr uint16_t LineDetectThreshold = 150;

uint16_t calibratedValues[SensorCount];
int16_t lastError = 0;

auto clampCommand(float value) -> int16_t {
    if (value > MaxCommand) return static_cast<int16_t>(MaxCommand);
    if (value < -MaxCommand) return static_cast<int16_t>(-MaxCommand);
    return static_cast<int16_t>(value);
}

auto lineFound(const uint16_t* values) -> bool {
    uint16_t peak = 0;
    for (uint8_t i = 0; i < SensorCount; ++i) {
        if (values[i] > peak) {
            peak = values[i];
        }
    }
    return peak >= LineDetectThreshold;
}

} // namespace

void setup() {
    Serial.begin(115200);
    while (!Serial) {
        delay(10);
    }

    qtr.setTypeRC();
    qtr.setSensorPins(SensorPins, SensorCount);
    qtr.setEmitterPin(EmitterPin);
    qtr.setTimeout(2500);

    pinMode(LED_BUILTIN, OUTPUT);
    digitalWrite(LED_BUILTIN, HIGH);

    Serial.println("QTR line follower demo");
    Serial.println("Move the sensor across both line and background during calibration.");

    for (uint16_t i = 0; i < 200; ++i) {
        qtr.calibrate();
        delay(10);
    }

    digitalWrite(LED_BUILTIN, LOW);

    Serial.println("Calibration min:");
    for (uint8_t i = 0; i < SensorCount; ++i) {
        Serial.print(qtr.calibrationOn.minimum[i]);
        Serial.print('\t');
    }
    Serial.println();

    Serial.println("Calibration max:");
    for (uint8_t i = 0; i < SensorCount; ++i) {
        Serial.print(qtr.calibrationOn.maximum[i]);
        Serial.print('\t');
    }
    Serial.println();

    Serial.println("Columns: pos\terror\tturn\tleft\tright\tfound");
}

void loop() {
    uint16_t position = FollowBlackLine
        ? qtr.readLineBlack(calibratedValues)
        : qtr.readLineWhite(calibratedValues);

    const bool found = lineFound(calibratedValues);

    if (!found) {
        digitalWrite(LED_BUILTIN, LOW);
        Serial.println("0\t0\t0\t0\t0\t0");
        delay(50);
        return;
    }

    const int16_t error = static_cast<int16_t>(position) - static_cast<int16_t>(PositionCenter);
    const int16_t deltaError = error - lastError;
    lastError = error;

    const float turn = Kp * error + Kd * deltaError;
    const int16_t leftCommand = clampCommand(BaseSpeed + turn);
    const int16_t rightCommand = clampCommand(BaseSpeed - turn);

    digitalWrite(LED_BUILTIN, HIGH);

    Serial.print(position);
    Serial.print('\t');
    Serial.print(error);
    Serial.print('\t');
    Serial.print(turn, 2);
    Serial.print('\t');
    Serial.print(leftCommand);
    Serial.print('\t');
    Serial.print(rightCommand);
    Serial.print('\t');
    Serial.println(1);

    delay(20);
}
